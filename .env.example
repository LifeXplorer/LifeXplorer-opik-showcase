# Copy to .env (git-ignored) and fill in. Every example walks up to this file,
# and each example's own .env.example lists only the variables it reads.

# --- Opik: local self-hosted (default; no API key needed) ---
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Used by temporal-py-grant-review's OTLP setup:
OPIK_URL=http://localhost:5173/api
# Used by quarkus-langchain4j-homebrew-rag:
OPIK_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
# Optional; most examples pin their project name in code.
# OPIK_PROJECT_NAME=

# --- Opik Cloud instead (https://www.comet.com/docs/opik/) ---
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/
# OPIK_URL=https://www.comet.com/opik/api
# OPIK_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# OPIK_WORKSPACE=<your-workspace>
# OPIK_API_KEY=<your-opik-api-key>

# --- LLM providers ---
# Required by every example: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Only for litellm-code-review-router: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
