# Copy to .env (git-ignored) and fill in. Every example walks up to this file.

# --- Opik (local self-hosted; no API key needed) ---
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY is only needed for Opik Cloud.

# --- LLM providers ---
# Required by almost every example: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Only for the Anthropic-based example: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
