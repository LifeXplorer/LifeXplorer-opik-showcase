# Key for the flow's gpt-4o-mini model. demo.py also finds a .env in any parent folder.
OPENAI_API_KEY=

# Where Langflow's built-in Opik tracer sends traces (self-hosted Opik shown).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default

# Opik Cloud instead:
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
# OPIK_WORKSPACE=your-workspace
# OPIK_API_KEY=your-opik-key
