# Provider key used for embeddings, the answering model and the judge metrics.
# Load order: this folder's .env, then the nearest .env found walking up the tree.
OPENAI_API_KEY=

# Opik: leave unset to use ~/.opik.config (run `opik configure`), or point at a local stack.
# OPIK_URL_OVERRIDE=http://localhost:5173/api/
# OPIK_WORKSPACE=default
# OPIK_API_KEY=   # Opik Cloud only
