# Provider keys for the two default models (a repo-root .env one level up is also picked up)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opik: local self-hosted needs no key. For Opik Cloud, set these (or run `opik configure`).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
OPIK_API_KEY=
