# OpenAI key: setup.sh turns it into an n8n credential at runtime;
# it is never written into the committed workflow file.
OPENAI_API_KEY=sk-...

# Optional: where the n8n container sends traces. Defaults to a local Opik
# (http://localhost:5173, workspace "default"). For Opik Cloud, set both:
# OPIK_OTEL_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# OPIK_OTEL_HEADERS=Authorization=<opik-api-key>,Comet-Workspace=<workspace>,projectName=n8n-foodbank-volunteer-screening
