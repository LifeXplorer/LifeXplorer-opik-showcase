# Copy to .env (git-ignored), or keep the keys in a repo-root .env; run.sh reads either.
# Required: the chat model (gpt-4o-mini) and the embedding model both use it.
OPENAI_API_KEY=

# Where Opik's OTLP endpoint lives. Defaults target a local self-hosted Opik.
OPIK_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=quarkus-langchain4j-homebrew-rag
# Opik Cloud needs an Authorization header too: export
# QUARKUS_OTEL_EXPORTER_OTLP_TRACES_HEADERS="Authorization=<key>,Comet-Workspace=<ws>,projectName=<project>"
