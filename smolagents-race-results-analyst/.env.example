# The agent runs on gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# Opik. Defaults below target a local self-hosted Opik (http://localhost:5173).
# For Opik Cloud use OPIK_URL=https://www.comet.com/opik/api and set OPIK_API_KEY + OPIK_WORKSPACE.
OPIK_URL=http://localhost:5173/api
OPIK_WORKSPACE=default
OPIK_API_KEY=
