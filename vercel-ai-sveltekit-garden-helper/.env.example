# OpenAI key: gpt-4o-mini answers the chat (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Opik, local self-hosted (https://www.comet.com/docs/opik/self-host/overview).
# A local stack needs no API key.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default

# For Opik Cloud instead, use:
#   OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
#   OPIK_API_KEY=your-opik-api-key
#   OPIK_WORKSPACE=your-workspace
