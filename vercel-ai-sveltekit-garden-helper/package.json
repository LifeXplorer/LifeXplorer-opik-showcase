{
  "name": "vercel-ai-sveltekit-garden-helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Streaming home-gardening chat assistant on SvelteKit and the Vercel AI SDK",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "demo": "tsx scripts/demo.ts",
    "verify": "tsx scripts/verify.ts",
    "pretest": "svelte-kit sync",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.123",
    "@ai-sdk/otel": "^1.0.181",
    "@ai-sdk/svelte": "^5.0.181",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/sdk-node": "^0.223.2",
    "ai": "^7.0.181",
    "dotenv": "^18.0.10",
    "opik": "2.3.4",
    "opik-vercel": "2.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.6",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^24.0.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "opik-vercel": {
      "opik": "$opik"
    }
  }
}
