# OpenAI: the assistant runs on gpt-4o-mini
OPENAI_API_KEY=sk-...

# Opik: local self-hosted needs no API key. Traces land in the project named below.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_PROJECT_NAME=voltagent-bike-repair-desk
# Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api, OPIK_WORKSPACE=<workspace>, OPIK_API_KEY=<key>
